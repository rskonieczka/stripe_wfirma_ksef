{
  "name": "evillage/wfirma-ksef",
  "description": "Integrator webhook Stripe do wFirma w PHP",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "stripe/stripe-php": "^16.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
